# ============================================================
# Ari Integrated Holdings Inc. — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Site ──────────────────────────────────────────────────────
# Absolute public URL. Used for email links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://ariintegratedholdings.com

# ── Database ─────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/ari_holdings?sslmode=require

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_SECRET=your-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Correspondence routing ────────────────────────────────────
# All inbound correspondence (contact inquiries, alert-subscriber notices,
# meeting notifications) is routed to the CTO by default:
#   mitchelcarson@ariintegratedholdings.com
# Leave CORRESPONDENCE_EMAIL unset to keep that default. Set it only to
# redirect correspondence for a specific deployment (e.g. staging).
# CORRESPONDENCE_EMAIL=mitchelcarson@ariintegratedholdings.com

# ── Resend (Email Delivery) ───────────────────────────────────
# Required in production. Without RESEND_API_KEY nothing is sent and every
# sender (contact form, alert signups, broadcasts, meeting notices) reports an
# explicit failure instead of a silent fake success.
# Sign up at https://resend.com — free tier: 3,000 emails/month
# 1. Add and verify ariintegratedholdings.com in the Resend dashboard. Resend
#    only asks for records on its own selector and return-path subdomain
#    (resend._domainkey and the "send" subdomain); keep the existing Google
#    MX, root SPF, google._domainkey, and _dmarc records exactly as they are.
# 2. Generate an API key with "Sending" permission
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@ariintegratedholdings.com
RESEND_FROM_NAME=Ari Integrated Holdings Inc.

# Local development only: log outbound email instead of sending it. Dry-run
# sends are reported as NOT delivered (the contact form shows a dry-run notice,
# never "Inquiry sent"), and the flag is ignored in production builds.
# EMAIL_DRY_RUN=1

# ── Calendly (Meeting Scheduling) ─────────────────────────────
# Create event types in Calendly and paste their shareable URLs below.
NEXT_PUBLIC_CALENDLY_EXEC_ZOOM_URL=https://calendly.com/mitchel-carson/ari-integrated-holding-s-executive-meeting
NEXT_PUBLIC_CALENDLY_EXEC_INTRO_URL=
NEXT_PUBLIC_CALENDLY_INVESTOR_BRIEFING_URL=
NEXT_PUBLIC_CALENDLY_PARTNERSHIP_URL=

# ── Database seeding (local/staging only) ─────────────────────
# `npm run db:seed` creates EXECUTIVE accounts from this list and refuses to
# run when NODE_ENV=production. Format: "Name <email>, Name <email>".
# SEED_EXECUTIVES=Mitchel Carson <mitchelcarson@ariintegratedholdings.com>
# SEED_PASSWORD=   # optional; a random password is generated and printed once when unset
