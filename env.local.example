# ============================================================
# Ari Integrated Holdings Inc. — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Site ──────────────────────────────────────────────────────
# Absolute public URL. Used for email links, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://ariintegratedholdings.com

# ── Database ─────────────────────────────────────────────────
# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/ari_holdings?sslmode=require

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_SECRET=your-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Correspondence routing ────────────────────────────────────
# All inbound correspondence (contact inquiries, alert-subscriber notices,
# meeting notifications) is routed to the CTO by default:
#   mitchelcarson@ariintegratedholdings.com
# Leave CORRESPONDENCE_EMAIL unset to keep that default. Set it only to
# redirect correspondence for a specific deployment (e.g. staging).
# CORRESPONDENCE_EMAIL=mitchelcarson@ariintegratedholdings.com

# ── Resend (Email Delivery) ───────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# 1. Add and verify ariintegratedholdings.com in the Resend dashboard
# 2. Add the SPF, DKIM, and DMARC DNS records at your registrar
# 3. Generate an API key with "Sending" permission
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@ariintegratedholdings.com
RESEND_FROM_NAME=Ari Integrated Holdings Inc.

# ── Calendly (Meeting Scheduling) ─────────────────────────────
# Create event types in Calendly and paste their shareable URLs below.
NEXT_PUBLIC_CALENDLY_EXEC_ZOOM_URL=https://calendly.com/mitchel-carson/ari-integrated-holding-s-executive-meeting
NEXT_PUBLIC_CALENDLY_EXEC_INTRO_URL=
NEXT_PUBLIC_CALENDLY_INVESTOR_BRIEFING_URL=
NEXT_PUBLIC_CALENDLY_PARTNERSHIP_URL=
