# ============================================================
# ARI Integrated Holdings Inc. — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/ari_holdings

# ── NextAuth ──────────────────────────────────────────────────
NEXTAUTH_SECRET=your-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Resend (Email Delivery) ───────────────────────────────────
# Sign up at https://resend.com — free tier: 3,000 emails/month
# 1. Add and verify your domain (ariholdings.com) in the Resend dashboard
# 2. Add SPF, DKIM, DMARC DNS records your domain registrar
# 3. Generate an API key with "Sending" permission
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@ariholdings.com
RESEND_FROM_NAME=ARI Integrated Holdings Inc.
RESEND_IR_EMAIL=investor-relations@ariholdings.com

# ── Calendly (Meeting Scheduling) ─────────────────────────────
# Sign up at https://calendly.com (Standard plan recommended)
# Create 3 event types and paste their shareable URLs below
NEXT_PUBLIC_CALENDLY_EXEC_INTRO_URL=https://calendly.com/ari-holdings/executive-intro
NEXT_PUBLIC_CALENDLY_INVESTOR_BRIEFING_URL=https://calendly.com/ari-holdings/investor-briefing
NEXT_PUBLIC_CALENDLY_PARTNERSHIP_URL=https://calendly.com/ari-holdings/partnership

# ── CoinGecko (Live Treasury Prices) ──────────────────────────
# Optional — free Demo API key from https://www.coingecko.com/en/api
# Without a key, the free tier still works (30 req/min limit)
# COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxx

# ── Google OAuth (optional) ───────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Apple OAuth (optional) ────────────────────────────────────
# APPLE_ID=
# APPLE_SECRET=

# ── Twitter/X OAuth (optional) ────────────────────────────────
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
