    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.11.0",
    "moment": "^2.30.1",
    "next": "16.1.4",
    "next-auth": "^4.24.13",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.9.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
